digraph W5500Wiring {
    rankdir=LR;
    bgcolor="white";
    fontname="Helvetica";
    node [fontname="Helvetica", fontsize=11];
    edge [fontname="Helvetica", fontsize=10];

    labelloc="t";
    label="Wiring W5500 <-> ESP32-S3 Gateway <-> RPi4 (eth0, IP statis)\n(swapped from ENC28J60, on request -- same 5 wires reused, see enc28j60_wiring.dot in git history)";
    fontsize=15;

    subgraph cluster_w5500 {
        label="Modul W5500";
        style="rounded,filled";
        fillcolor="#fff5f5";
        color="#c53030";
        node [shape=box, style="rounded,filled", fillcolor="#fed7d7", color="#9b2c2c"];
        W5500_CS   [label="CS"];
        W5500_SCK  [label="SCK"];
        W5500_MOSI [label="MOSI"];
        W5500_MISO [label="MISO"];
        W5500_INT  [label="INT"];
        W5500_RST  [label="RST"];
        W5500_VCC  [label="VCC (3.3V)"];
        W5500_GND  [label="GND"];
        W5500_RJ45 [label="RJ45", shape=box, style="rounded,filled", fillcolor="#feb2b2", color="#822727"];
    }

    subgraph cluster_esp {
        label="ESP32-S3 (Gateway, node_id=0) -- SPI3_HOST, 8MHz\n(GPIO matrix, not IOMUX -- see luckfox_spi_wiring.dot for why\nSPI2_HOST's IOMUX pins went to the LuckFox link instead)";
        style="rounded,filled";
        fillcolor="#ebf8ff";
        color="#2b6cb0";
        node [shape=box, style="rounded,filled", fillcolor="#bee3f8", color="#2c5282"];
        ESP_CS   [label="GPIO7 (kEthCsPin)"];
        ESP_SCK  [label="GPIO6 (kEthSckPin)"];
        ESP_MOSI [label="GPIO4 (kEthMosiPin)"];
        ESP_MISO [label="GPIO5 (kEthMisoPin)"];
        ESP_INT  [label="GPIO9 (kEthIntPin)"];
        ESP_3V3  [label="3V3"];
        ESP_GND  [label="GND"];
    }

    subgraph cluster_rpi {
        label="Raspberry Pi 4";
        style="rounded,filled";
        fillcolor="#f0fff4";
        color="#2f855a";
        RPI_ETH0 [label="eth0\nIP statis 192.168.50.1/24\n(nmcli \"Wired connection 1\")", shape=box, style="rounded,filled", fillcolor="#c6f6d5", color="#22543d"];
    }

    ESP_CS -> W5500_CS [color="#805ad5", penwidth=1.5];
    ESP_SCK -> W5500_SCK [color="#805ad5", penwidth=1.5];
    ESP_MOSI -> W5500_MOSI [label="  data", color="#2b6cb0", penwidth=2];
    W5500_MISO -> ESP_MISO [label="  data", color="#c53030", penwidth=2, dir=back];
    W5500_INT -> ESP_INT [label="  interrupt", color="#dd6b20", penwidth=1.5];
    ESP_3V3 -> W5500_VCC [color="#38a169", style=dashed];
    ESP_GND -> W5500_GND [dir=none, style=dashed, color="#4a5568"];
    W5500_RST -> ESP_3V3 [label="  (tie high / not used,\n  reset_gpio_num=-1)", style=dotted, color="#a0aec0", dir=none];

    W5500_RJ45 -> RPI_ETH0 [label="  kabel RJ45 langsung\n  (auto-MDIX, straight-through OK)", color="#c05621", penwidth=2.5, style=bold];

    NOTE [shape=note, style=filled, fillcolor="#fefcbf", color="#b7791f", fontsize=10,
          label="Link langsung (bukan lewat switch/router) -> tidak ada DHCP server,\nkarena itu KEDUA sisi pakai IP statis: ESP32-S3=192.168.50.2, RPi4 eth0=192.168.50.1.\nJANGAN sambung VBUS/5V ke W5500 -- pakai 3.3V (VCC); cek arus modul yang dipakai\n(belum diukur untuk unit ini -- beda dari ENC28J60 yang sebelumnya diukur ~180mA),\npastikan sumber 3.3V ESP32-S3 sanggup, kalau tidak stabil pakai regulator 3.3V terpisah.\nDiuji nyata di hardware: link up, static IP 192.168.50.2 langsung dapat, ping RPi4 0% loss."];
}
